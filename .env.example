# Server environment variables
PORT=4000
NODE_ENV=development

# Primary database location. On Render the persistent disk is mounted at
# /app/server/data, so production sets this to
# /app/server/data/stagecore.sqlite. Locally it defaults to
# server/data/stagecore.sqlite.
CORE_DB_PATH=

# Auth — generate a real secret for production: openssl rand -hex 32
# Required in production; the server refuses to boot without it. Changing this
# value invalidates every existing session (tokens are HMAC-signed with it), so
# manage it as a stable secret rather than regenerating it on each deploy.
CORE_AUTH_SESSION_SECRET=
CORE_ADMIN_EMAILS=

# Session cookie SameSite policy: "lax" for same-origin deploys, "none" when a
# cross-site frontend (e.g. Vercel preview) calls the API. Defaults to "none"
# in production and "lax" elsewhere.
CORE_AUTH_COOKIE_SAMESITE=

# Google OAuth
GOOGLE_CLIENT_ID=

# CORS — comma-separated list of exact origins allowed to make credentialed
# requests. Production origins are configuration, not code: list every frontend
# that calls this API (Render same-origin URL, a Vercel frontend, etc.). Local
# loopback origins are always allowed outside production.
FRONTEND_ORIGIN=
CORS_ORIGIN=

# Secondary (off-box) backup to a private GitHub repository. Leave both unset to
# disable backups. GITHUB_BACKUP_TOKEN must be a minimal-scope, dedicated token
# with contents:write on the single backup repo only — never a personal token.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=
# Timestamped snapshots retained in the backup repo (default 7).
BACKUP_RETENTION=

# Disaster recovery. Restore only ever happens into an EMPTY database; a
# populated database is never overwritten. When set to 1 and the restore FAILS,
# the app exits non-zero instead of silently falling back to the canonical seed.
# Keep this unset/0 for normal operation.
# Values treated as enabled: 1, true, yes (case-insensitive).
CORE_ALLOW_GITHUB_RESTORE=0

# Optional features
CORE_BACKFILL_NEWS_ON_STARTUP=
CORE_BACKFILL_NORMALIZED_ON_STARTUP=
