# Server environment variables
PORT=4000
NODE_ENV=development

# Auth — generate a real secret for production: openssl rand -hex 32
CORE_AUTH_SESSION_SECRET=
CORE_ADMIN_EMAILS=

# Google OAuth
GOOGLE_CLIENT_ID=

# CORS
FRONTEND_ORIGIN=
CORS_ORIGIN=

# Database (Turso — set in Render dashboard, never commit)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional features
CORE_BACKFILL_NEWS_ON_STARTUP=
CORE_BACKFILL_NORMALIZED_ON_STARTUP=
